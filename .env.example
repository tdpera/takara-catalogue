# Copy to .env.local. For local dev, `pnpm db:start` prints these values.

# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix these with NEXT_PUBLIC_.
# Used from step 4 (AI fill) and step 6 (public share links).
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults: claude-opus-5-5 and low effort (see DECISIONS.md, sections 10 and 15).
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
